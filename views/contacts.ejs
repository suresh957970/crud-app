<%- include('header.ejs') %>

    <div class="container mt-4">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h4 class="mb-0">Contacts</h4>
          <a href="/create-contact" class="btn btn-light btn-sm">Add Contact</a>
        </div>

        <div class="card-body p-0">
          <% if (contacts && contacts.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Phone</th>
                    <th scope="col" class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% contacts.forEach((contact, index) => { %>
                    <tr>
                      <th scope="row"><%= index + 1 %></th>
                      <td><%= contact.first_name +' '+ contact.last_name %></td>
                      <td><%= contact.email %></td>
                      <td><%= contact.phone %></td>
                      <td class="text-center">
                        <div class="btn-group" role="group" aria-label="Contact actions">
                          <a href="/view-contact/<%= contact._id %>" class="btn btn-sm btn-outline-primary">
                            View
                          </a>
                          <a href="/edit-contact/<%= contact._id %>" class="btn btn-sm btn-outline-warning">
                            Edit
                          </a>
                          <a href="/delete-contact/<%= contact._id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this contact?');">
                            Delete
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="alert alert-info m-3 mb-0" role="alert">
              No contacts found.
            </div>
          <% } %>
        </div>
      </div>
    </div>

<%- include('footer.ejs') %>
